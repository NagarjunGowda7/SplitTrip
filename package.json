{
  "name": "splittrip",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "homepage": "https://NagarjunGowda7.github.io/SplitTrip",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-gh-pages-dist.js",
    "build:apk": "npx eas-cli@latest build -p android --profile preview",
    "build:aab": "npx eas-cli@latest build -p android --profile production",
    "deploy": "npm run build:web && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "^55.0.18",
    "expo-asset": "~55.0.16",
    "expo-constants": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-font": "~55.0.6",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-print": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "firebase": "^11.10.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "read-excel-file": "^9.0.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
